/**
 * TokenDashboard — Real-time token usage & context observability dashboard.
 * Uses actual tiktoken-based counts from the backend, not dummy estimates.
 */

import { useState, useEffect, useRef } from 'react';
import {
  ResponsiveContainer,
  LineChart,
  Line,
  XAxis,
  YAxis,
  Tooltip,
  ReferenceLine,
  CartesianGrid,
} from 'recharts';
import type { ContextMetrics, StatusResponse, ProviderInfo, ContextEvent, ContextBudget } from '../types';

interface Props {
  isOpen: boolean;
  onClose: () => void;
  contextMetrics: ContextMetrics | null;
  activeProvider?: string;
  activeStrategy?: string;
}

function formatTokens(tokens: number): string {
  if (!tokens || isNaN(tokens)) return '0';
  if (tokens >= 1000000) return (tokens / 1000000).toFixed(2) + 'M';
  if (tokens >= 1000) return (tokens / 1000).toFixed(1) + 'K';
  return tokens.toLocaleString();
}

export default function TokenDashboard({
  isOpen,
  onClose,
  contextMetrics,
  activeProvider = 'Ollama',
  activeStrategy = 'recursive_summarization',
}: Props) {
  const [metricsData, setMetricsData] = useState<StatusResponse['metrics'] | null>(null);
  const [providers, setProviders] = useState<ProviderInfo[]>([]);
  const [loading, setLoading] = useState(false);
  const [activeTab, setActiveTab] = useState<'overview' | 'strategies' | 'history' | 'events'>('overview');
  const [contextEvents, setContextEvents] = useState<ContextEvent[]>([]);
  const [contextState, setContextState] = useState<string>('INITIAL');
  const [contextBudget, setContextBudget] = useState<ContextBudget | null>(null);
  const [demoRunning, setDemoRunning] = useState(false);
  const pollRef = useRef<ReturnType<typeof setInterval> | null>(null);

  const fetchMetrics = async () => {
    setLoading(true);
    try {
      const res = await fetch('/api/status');
      if (res.ok) {
        const data: StatusResponse = await res.json();
        setMetricsData(data.metrics);
        setProviders(data.providers || []);
      }
    } catch (err) {
      console.error('Failed to fetch status metrics:', err);
    } finally {
      setLoading(false);
    }
  };

  const fetchContextBudget = async () => {
    try {
      const res = await fetch('/api/context-budget');
      if (res.ok) {
        const data: ContextBudget = await res.json();
        setContextBudget(data);
      }
    } catch (err) {
      console.error('Failed to fetch context budget:', err);
    }
  };

  // Determine sessionId from contextMetrics or use a default for demo
  const fetchContextEvents = async () => {
    const sid = contextMetrics?.sessionId;
    if (!sid) return;
    try {
      const res = await fetch(`/api/context-events/${sid}`);
      if (res.ok) {
        const data = await res.json();
        setContextEvents(data.events || []);
        setContextState(data.state || 'INITIAL');
      }
    } catch (err) {
      console.error('Failed to fetch context events:', err);
    }
  };

  const runContextDemo = async () => {
    setDemoRunning(true);
    try {
      const res = await fetch('/api/context-demo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messageCount: 20 }),
      });
      if (res.ok) {
        const data = await res.json();
        setContextEvents(data.events || []);
        setContextState(data.state || 'INITIAL');
        if (data.contextMetrics) {
          // Don't overwrite the real contextMetrics, just show demo results in events
        }
      }
    } catch (err) {
      console.error('Context demo failed:', err);
    } finally {
      setDemoRunning(false);
    }
  };

  // Live polling while dashboard is open
  useEffect(() => {
    if (isOpen) {
      fetchMetrics();
      fetchContextBudget();
      fetchContextEvents();
      pollRef.current = setInterval(() => {
        fetchMetrics();
        fetchContextBudget();
        fetchContextEvents();
      }, 3000);
    }
    return () => {
      if (pollRef.current) clearInterval(pollRef.current);
      pollRef.current = null;
    };
  }, [isOpen]);

  // Handle ESC key to close
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isOpen) onClose();
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [isOpen, onClose]);

  if (!isOpen) return null;

  // ─── Current session context window (real token counts) ───
  const currentTotalTokens = contextMetrics?.totalTokens || 0;
  const maxTokens = contextMetrics?.maxTokens || contextBudget?.maxTokens || 1500;
  const utilizationRaw = maxTokens > 0 ? (currentTotalTokens / maxTokens) * 100 : 0;
  const utilizationPct = Math.min(100, utilizationRaw);

  const previousTokens = contextMetrics?.previousTokens || currentTotalTokens;
  const lastTokensSaved = contextMetrics?.lastTokensSaved || 0;
  const cumulativeTokensSaved = contextMetrics?.cumulativeTokensSaved || 0;
  const tokensSaved = contextMetrics?.wasCompressed ? lastTokensSaved : 0;
  const savingsPct = previousTokens > 0 && tokensSaved > 0 ? Math.round((tokensSaved / previousTokens) * 100) : 0;

  const totalEstimated = (metricsData?.totalTokensEstimated || 0) + currentTotalTokens;
  const avgTokensPerReq = metricsData?.totalRequests
    ? Math.round(totalEstimated / Math.max(1, metricsData.totalRequests))
    : currentTotalTokens;

  // Token composition breakdown (from actual context assembly, not estimates)
  const cb = contextMetrics?.categoryBreakdown;
  const systemPromptTokens = cb?.systemPrompt ?? 0;
  const summaryTokens = cb?.summaryMemory ?? (contextMetrics?.summaryTokens || 0);
  const conversationTokens = cb?.conversationHistory ?? (contextMetrics?.messageTokens || 0);
  const userPromptTokens = cb?.userPrompt ?? 0;
  const codeContextTokens = cb?.codeContext ?? 0;
  const toolTokens = cb?.toolDefinitions ?? 0;
  const otherTokens = cb?.other ?? 0;

  const totalForBreakdown = systemPromptTokens + summaryTokens + conversationTokens + userPromptTokens + codeContextTokens + toolTokens + otherTokens || currentTotalTokens || 1;

  const systemPct = Math.round((systemPromptTokens / totalForBreakdown) * 100);
  const summaryPct = Math.round((summaryTokens / totalForBreakdown) * 100);
  const chatPct = Math.round((conversationTokens / totalForBreakdown) * 100);
  const codePct = Math.round((codeContextTokens / totalForBreakdown) * 100);
  const userPct = Math.round((userPromptTokens / totalForBreakdown) * 100);

  const THRESHOLD_PCT = 70;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md animate-fade-in">
      <div className="bg-[var(--bg-surface)] border border-[var(--border-subtle)] w-full max-w-4xl max-h-[90vh] rounded-2xl shadow-2xl flex flex-col overflow-hidden text-[var(--text-primary)]">

        {/* Modal Header */}
        <div className="px-6 py-4 border-b border-[var(--border-subtle)] flex items-center justify-between bg-[var(--bg-secondary)] shrink-0">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 to-pink-600 flex items-center justify-center shadow-lg shadow-purple-500/20">
              <span className="text-xl">⚡</span>
            </div>
            <div>
              <div className="flex items-center gap-2">
                <h2 className="text-base font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
                  Token Usage & Context Dashboard
                </h2>
                <span className="text-[10px] px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-400 border border-purple-500/20 font-medium">
                  Live Observability
                </span>
              </div>
              <p className="text-xs text-[var(--text-muted)]">
                Real subword token counts (tiktoken cl100k_base) · Context window · LLM orchestration
              </p>
            </div>
          </div>

          <div className="flex items-center gap-2">
            <button
              onClick={fetchMetrics}
              disabled={loading}
              className="p-2 rounded-lg bg-white/5 hover:bg-white/10 text-[var(--text-muted)] hover:text-white transition-all text-xs flex items-center gap-1.5"
              title="Refresh Metrics"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" className={loading ? 'animate-spin' : ''}>
                <path d="M23 4v6h-6M1 20v-6h6" />
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
              </svg>
              <span>Refresh</span>
            </button>
            <button
              onClick={onClose}
              className="p-2 rounded-lg bg-white/5 hover:bg-red-500/20 hover:text-red-400 text-[var(--text-muted)] transition-all"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>
        </div>

        {/* Navigation Tabs */}
        <div className="flex items-center gap-2 px-6 pt-3 border-b border-[var(--border-subtle)] bg-[var(--bg-surface)] shrink-0">
          <button
            onClick={() => setActiveTab('overview')}
            className={`pb-2.5 px-3 text-xs font-semibold transition-all border-b-2 flex items-center gap-1.5 ${
              activeTab === 'overview'
                ? 'border-purple-500 text-purple-400'
                : 'border-transparent text-[var(--text-muted)] hover:text-[var(--text-secondary)]'
            }`}
          >
            <span>📊</span> Token Overview
          </button>
          <button
            onClick={() => setActiveTab('strategies')}
            className={`pb-2.5 px-3 text-xs font-semibold transition-all border-b-2 flex items-center gap-1.5 ${
