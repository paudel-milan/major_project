/**
 * Google Gemini LLM Provider — uses @google/generative-ai package.
 * Supports Gemini Pro, Flash models.
 */

import { BaseLLMProvider } from './BaseLLMProvider.js';
import logger from '../utils/logger.js';

export class GeminiProvider extends BaseLLMProvider {
  constructor() {
    super();
    this._apiKey = process.env.GEMINI_API_KEY || '';
    this._model = process.env.GEMINI_MODEL || 'gemini-2.0-flash';
    this._client = null;

    if (this._apiKey) {
      logger.info('Gemini', `Initialized with model: ${this._model}`);
    }
  }

  get name() { return 'gemini'; }
  get displayName() { return `Google Gemini (${this._model})`; }

  isConfigured() {
    return !!this._apiKey;
  }

  async _getClient() {
    if (!this._client) {
      try {
        const { GoogleGenerativeAI } = await import('@google/generative-ai');
        this._client = new GoogleGenerativeAI(this._apiKey);
      } catch {
        throw new Error('@google/generative-ai package not installed. Run: npm install @google/generative-ai');
      }
    }
    return this._client;
  }

  async generateResponse(prompt, context = []) {
    if (!this.isConfigured()) throw new Error('Gemini not configured — set GEMINI_API_KEY');

    const client = await this._getClient();
    const model = client.getGenerativeModel({
      model: this._model,
      generationConfig: {
        temperature: 0.7,
        maxOutputTokens: 16384,
        responseMimeType: 'application/json',
      },
    });

    // Build conversation history for Gemini format
    const history = context.map(m => ({
      role: m.role === 'assistant' ? 'model' : 'user',
      parts: [{ text: m.content }],
    }));

    const startTime = Date.now();
    const estimatedPromptTokens = Math.ceil(prompt.split(/\s+/).length * 1.3);

    try {
      const chat = model.startChat({ history });
      const result = await chat.sendMessage(prompt);
      const responseText = result.response.text();

      const durationMs = Date.now() - startTime;
      const reportedPromptTokens = result.response.usageMetadata?.promptTokenCount || estimatedPromptTokens;
      const responseTokens = result.response.usageMetadata?.candidatesTokenCount || Math.ceil(responseText.split(/\s+/).length * 1.3);
      logger.logLLMCall('gemini', reportedPromptTokens, responseTokens, durationMs);

      return {
        text: responseText.trim(),
        usage: {
          promptTokens: reportedPromptTokens,
          completionTokens: responseTokens,
          totalTokens: reportedPromptTokens + responseTokens,
          providerReported: !!result.response.usageMetadata?.promptTokenCount,
        },
      };
    } catch (error) {
      logger.error('Gemini', `API error: ${error.message}`);
      throw error;
    }
  }

  async healthCheck() {
    if (!this.isConfigured()) return false;
    try {
      const client = await this._getClient();
      const model = client.getGenerativeModel({ model: this._model });
      await model.generateContent('test');
      return true;
    } catch {
      return false;
    }
  }
}
</file>

<file path="backend/utils/logger.js">
/**
 * Structured Logger — tracks token usage, response time, context size, build time.
 * Supports the "Optimize context management for agentic AI" research goal.
 */

const LOG_LEVELS = { debug: 0, info: 1, warn: 2, error: 3 };

class Logger {
  constructor() {
    this.level = LOG_LEVELS[process.env.LOG_LEVEL || 'info'] || 1;
  this.metrics = {
    totalRequests: 0,
    totalTokensEstimated: 0,
    totalInputTokens: 0,
    totalOutputTokens: 0,
    totalBuildTime: 0,
    totalLLMTime: 0,
    summarizations: 0,
  };
  }

  _timestamp() {
    return new Date().toISOString();
  }

  _format(level, category, message, data = {}) {
    const entry = {
      timestamp: this._timestamp(),
      level,
      category,
      message,
      ...data,
    };
    return entry;
  }

  debug(category, message, data) {
    if (this.level <= LOG_LEVELS.debug) {
      const entry = this._format('DEBUG', category, message, data);
      console.log(`\x1b[90m[${entry.timestamp}] [DEBUG] [${category}] ${message}\x1b[0m`, data || '');
    }
  }

  info(category, message, data) {
    if (this.level <= LOG_LEVELS.info) {
      const entry = this._format('INFO', category, message, data);
      console.log(`\x1b[36m[${entry.timestamp}] [INFO] [${category}]\x1b[0m ${message}`, data ? JSON.stringify(data) : '');
    }
  }

  warn(category, message, data) {
    if (this.level <= LOG_LEVELS.warn) {
      const entry = this._format('WARN', category, message, data);
      console.warn(`\x1b[33m[${entry.timestamp}] [WARN] [${category}]\x1b[0m ${message}`, data ? JSON.stringify(data) : '');
    }
  }

  error(category, message, data) {
    const entry = this._format('ERROR', category, message, data);
    console.error(`\x1b[31m[${entry.timestamp}] [ERROR] [${category}]\x1b[0m ${message}`, data ? JSON.stringify(data) : '');
  }

  // ─── Specialized logging for benchmarking ───

  logLLMCall(provider, promptTokens, responseTokens, durationMs) {
    this.metrics.totalRequests++;
    this.metrics.totalInputTokens += promptTokens;
    this.metrics.totalOutputTokens += responseTokens;
    this.metrics.totalTokensEstimated += (promptTokens + responseTokens);
    this.metrics.totalLLMTime += durationMs;

    this.info('LLM', `${provider} call completed`, {
      provider,
      promptTokens,
      responseTokens,
      totalTokens: promptTokens + responseTokens,
      durationMs,
      avgTokensPerRequest: Math.round(this.metrics.totalTokensEstimated / this.metrics.totalRequests),
    });
  }

  logContextSize(sessionId, messageCount, tokenEstimate, hasSummary) {
    this.info('Context', `Session ${sessionId} context`, {
      sessionId,
      messageCount,
      tokenEstimate,
      hasSummary,
    });
  }

  logSummarization(sessionId, originalMessages, afterMessages, durationMs) {
    this.metrics.summarizations++;
    this.info('Context', `Summarization performed`, {
      sessionId,
      originalMessages,
      afterMessages,
      compressed: originalMessages - afterMessages,
      durationMs,
      totalSummarizations: this.metrics.summarizations,
    });
  }

  logBuildTime(projectId, durationMs, success) {
    this.metrics.totalBuildTime += durationMs;
    this.info('Build', `Build ${success ? 'completed' : 'failed'}`, {
      projectId,
      durationMs,
      success,
    });
  }

  logAgentStep(step, message, data) {
    this.info('Agent', `[${step}] ${message}`, data);
  }

  getMetrics() {
    return { ...this.metrics };
  }
}

const logger = new Logger();
export default logger;
</file>

<file path="backend/utils/tokenizer.js">
/**
 * Tokenizer — real subword token counting using js-tiktoken (cl100k_base).
 * Falls back to a word heuristic if the encoder cannot be loaded.
 */

import { getEncoding, encodingForModel } from 'js-tiktoken';

let _encoder = null;
let _loadError = null;

function _ensureEncoder() {
  if (_encoder) return _encoder;
  if (_loadError) return null;
  try {
    _encoder = getEncoding('cl100k_base');
  } catch (err) {
    _loadError = err;
    return null;
  }
  return _encoder;
}

/**
 * Count tokens for a string using cl100k_base (OpenAI-compatible).
 * Falls back to ~1.3 tokens/word if js-tiktoken is unavailable.
 * @param {string} text
 * @returns {number}
 */
export function countTokens(text) {
  if (!text) return 0;
  const enc = _ensureEncoder();
  if (enc) {
    try {
      return enc.encode(text).length;
    } catch {
      // fall through to heuristic
    }
  }
  return Math.ceil(text.split(/\s+/).filter(w => w.length > 0).length * 1.3);
}

/**
 * Count tokens for a message array (role + content).
 * @param {Array<{role: string, content: string}>} messages
 * @returns {number}
 */
export function countMessagesTokens(messages) {
  if (!Array.isArray(messages)) return 0;
  let total = 0;
  for (const msg of messages) {
    total += countTokens(msg.content || '');
    total += 4; // per-message formatting overhead
  }
  return total;
}

/**
 * Approximate tokens for a model-specific encoding when available.
 * @param {string} text
 * @param {string} [model]
 * @returns {number}
 */
export function countTokensForModel(text, model) {
  if (!text) return 0;
  try {
    const enc = encodingForModel(model || 'gpt-4o-mini');
    return enc.encode(text).length;
  } catch {
    return countTokens(text);
  }
}
