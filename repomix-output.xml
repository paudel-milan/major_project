<file path="backend/builder/BuildEngine.js">
/**
 * BuildEngine — handles building sandbox React projects.
 * Since we use CDN-loaded React + Babel (browser-based transpilation),
 * the "build" step is lightweight: validate files and prepare for serving.
 * For production, this could use Vite's programmatic build API.
 */

import fs from 'fs/promises';
import path from 'path';
import projectManager from './ProjectManager.js';
import logger from '../utils/logger.js';

class BuildEngine {
  constructor() {
    this._buildStatus = new Map(); // projectId -> { status, error, timestamp }
  }

  /**
   * "Build" a sandbox project — validate and prepare for serving.
   * Since we use CDN React + Babel, this is mainly validation + notification.
   * @param {string} projectId
   * @param {Function} [onStatus] - Callback for status updates
   * @returns {Promise<{success: boolean, error?: string, duration: number}>}
   */
  async build(projectId, onStatus = null) {
    const startTime = Date.now();

    this._updateStatus(projectId, 'building');
    if (onStatus) onStatus({ status: 'building', projectId });

    try {
      // 1. Verify project exists
      const projectPath = projectManager.getProjectPath(projectId);
      
      // 2. Verify index.html exists
      const indexPath = path.join(projectPath, 'index.html');
      try {
        await fs.access(indexPath);
      } catch {
        throw new Error('index.html not found in project');
      }

      // 3. Verify App.jsx exists
      const appPath = path.join(projectPath, 'src', 'App.jsx');
      try {
        await fs.access(appPath);
      } catch {
        throw new Error('src/App.jsx not found in project');
      }

      // 4. Process component files — inject window exports
      await this._processComponents(projectId);

      // 5. Update index.html to include all component scripts
      await this._updateIndexHtml(projectId);

      const duration = Date.now() - startTime;
      this._updateStatus(projectId, 'ready');
      logger.logBuildTime(projectId, duration, true);

      if (onStatus) onStatus({ status: 'ready', projectId, duration });

      return { success: true, duration };
    } catch (error) {
      const duration = Date.now() - startTime;
      this._updateStatus(projectId, 'error', error.message);
      logger.logBuildTime(projectId, duration, false);
      logger.error('BuildEngine', `Build failed for ${projectId}: ${error.message}`);

      if (onStatus) onStatus({ status: 'error', projectId, error: error.message });

      return { success: false, error: error.message, duration };
    }
  }

  /**
   * Process component files to ensure they work with browser-based module system.
   * Strips ES imports, adds React hook globals, and ensures window exports.
   */
  async _processComponents(projectId) {
    const files = projectManager.getProjectFiles(projectId);

    for (const [filePath, content] of Object.entries(files)) {
      if (filePath.endsWith('.jsx') || filePath.endsWith('.js')) {
        let processed = content;

        // 1. Remove all React-related import statements
        //    - import React from 'react'
        //    - import { useState, useEffect } from 'react'
        //    - import React, { useState } from 'react'
        //    - import ReactDOM from 'react-dom'
        //    - import * as React from 'react'
        processed = processed.replace(/^import\s+(?:React|ReactDOM|\*\s+as\s+React).*from\s+['"]react(?:-dom)?['"];?\s*$/gm, '');
        processed = processed.replace(/^import\s+\{[^}]*\}\s+from\s+['"]react(?:-dom)?['"];?\s*$/gm, '');
        processed = processed.replace(/^import\s+React\s*,\s*\{[^}]*\}\s+from\s+['"]react['"];?\s*$/gm, '');

        // 2. Inject React hook destructuring at the top so bare useState() works
        //    (The global aliases from index.html handle this too, but this is a safety net
        //     for when components are loaded before the global <script> runs)
        const hookLine = 'const { useState, useEffect, useRef, useCallback, useMemo, useReducer, useContext, createContext, Fragment } = React;\n';
        // Only inject if the file uses any hooks and doesn't already have the destructuring
        const usesHooks = /\b(useState|useEffect|useRef|useCallback|useMemo|useReducer|useContext|createContext)\s*[.(]/.test(processed);
        const alreadyHasDestructuring = /const\s*\{[^}]*useState[^}]*\}\s*=\s*React/.test(processed);
        if (usesHooks && !alreadyHasDestructuring) {
          processed = hookLine + processed;
        }

        // 3. Handle exports — order matters: check `export default function/class` FIRST,
        //    then `export default <Name>` (the simple re-export form)
        const funcExportMatch = processed.match(/export\s+default\s+function\s+(\w+)/);
        const classExportMatch = processed.match(/export\s+default\s+class\s+(\w+)/);
        const arrowExportMatch = processed.match(/export\s+default\s+(\([^)]*\)|[a-zA-Z_]\w*)\s*=>/);

        if (funcExportMatch) {
          // `export default function Foo(...)` → `function Foo(...)`
          const componentName = funcExportMatch[1];
          processed = processed.replace(/export\s+default\s+function\s+/, 'function ');
          processed += `\nwindow.${componentName} = ${componentName};\n`;
        } else if (classExportMatch) {
          // `export default class Foo` → `class Foo`
          const componentName = classExportMatch[1];
          processed = processed.replace(/export\s+default\s+class\s+/, 'class ');
          processed += `\nwindow.${componentName} = ${componentName};\n`;
        } else if (arrowExportMatch) {
          // `export default () => ...` — wrap in a named function
          // Extract a name from the file path
          const baseName = filePath.replace(/.*\//, '').replace(/\.(jsx|js)$/, '');
          const componentName = baseName.charAt(0).toUpperCase() + baseName.slice(1);
          processed = processed.replace(/export\s+default\s+/, `const ${componentName} = `);
          processed += `\nwindow.${componentName} = ${componentName};\n`;
        } else {
          // `export default SomeComponent;` (simple re-export)
          const simpleExportMatch = processed.match(/export\s+default\s+(\w+)\s*;?/);
          if (simpleExportMatch) {
            const componentName = simpleExportMatch[1];
            processed = processed.replace(/export\s+default\s+\w+\s*;?/, '');
            processed += `\nwindow.${componentName} = ${componentName};\n`;
          }
        }

        // 4. Replace relative imports with window references
        processed = processed.replace(
          /import\s+(\w+)\s+from\s+['"]\.\/(?:components\/)?([\w/]+)['"];?/g,
          (match, name) => `const ${name} = window.${name};`
        );

        // 5. For App.jsx specifically, ensure window.AppComponent is set
        //    even if the LLM named the component something other than App
        if (filePath === 'src/App.jsx' && !processed.includes('window.AppComponent')) {
          // Find the main function/const declaration
          const mainFuncMatch = processed.match(/(?:function|const|class)\s+(\w+)/);
          if (mainFuncMatch) {
            const name = mainFuncMatch[1];
            processed += `\nwindow.AppComponent = ${name};\n`;
          }
        }

        // Write processed file
        const projectPath = projectManager.getProjectPath(projectId);
        await fs.writeFile(path.join(projectPath, filePath), processed, 'utf-8');
      }
    }
  }

  /**
   * Update index.html to include script tags for all component files.
   * Component scripts must load BEFORE App.jsx so window references resolve.
   */
  async _updateIndexHtml(projectId) {
    const files = projectManager.getProjectFiles(projectId);
    const projectPath = projectManager.getProjectPath(projectId);
    const indexPath = path.join(projectPath, 'index.html');

    let indexContent = await fs.readFile(indexPath, 'utf-8');

    // Collect all JSX/JS files (order: components first, then App.jsx)
    const componentFiles = Object.keys(files)
      .filter(f => (f.endsWith('.jsx') || f.endsWith('.js')) && f !== 'src/App.jsx')
      .sort();

    // Build script tags for components (must load before App.jsx)
    // Use type="text/babel" consistently (NO data-type="module" for components)
    const componentScripts = componentFiles
      .map(f => `  <script type="text/babel" src="./${f}"></script>`)
      .join('\n');

    // Inject component scripts before the App.jsx script
    if (componentScripts && !indexContent.includes('<!-- COMPONENT_SCRIPTS -->')) {
      indexContent = indexContent.replace(
        '<script type="text/babel" data-type="module" src="./src/App.jsx"></script>',
        `<!-- COMPONENT_SCRIPTS -->\n${componentScripts}\n  <script type="text/babel" data-type="module" src="./src/App.jsx"></script>`
      );
    } else if (componentScripts) {
      // Update existing component scripts block
      indexContent = indexContent.replace(
        /<!-- COMPONENT_SCRIPTS -->[\s\S]*?<script type="text\/babel" data-type="module" src="\.\/src\/App\.jsx"><\/script>/,
        `<!-- COMPONENT_SCRIPTS -->\n${componentScripts}\n  <script type="text/babel" data-type="module" src="./src/App.jsx"></script>`
      );
    }

    await fs.writeFile(indexPath, indexContent, 'utf-8');
  }

  /**
   * Rebuild only — for incremental updates.
   */
  async rebuild(projectId, onStatus = null) {
    logger.info('BuildEngine', `Incremental rebuild for project ${projectId}`);
    return this.build(projectId, onStatus);
  }

  /**
   * Get the current build status for a project.
   */
  getStatus(projectId) {
    return this._buildStatus.get(projectId) || { status: 'unknown' };
  }

  _updateStatus(projectId, status, error = null) {
    this._buildStatus.set(projectId, {
      status,
      error,
      timestamp: Date.now(),
    });
  }
}

const buildEngine = new BuildEngine();
export default buildEngine;
</file>

<file path="backend/builder/templateFiles.js">
/**
 * Template Files — base React project scaffold for sandbox apps.
 * The LLM's generated code gets injected into this template.
 * Uses Tailwind CDN for zero-config styling in sandboxed projects.
 */

export const templateFiles = {
  'index.html': `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Generated App</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body>
  <div id="root"></div>
  <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <script>
    // Expose React hooks as globals so bare useState() etc. works
    var useState = React.useState;
    var useEffect = React.useEffect;
    var useRef = React.useRef;
    var useCallback = React.useCallback;
    var useMemo = React.useMemo;
    var useReducer = React.useReducer;
    var useContext = React.useContext;
    var createContext = React.createContext;
    var Fragment = React.Fragment;
    var useId = React.useId;
    var useSyncExternalStore = React.useSyncExternalStore;
    var useTransition = React.useTransition;
    var useDeferredValue = React.useDeferredValue;

    // Global error handler — show errors visibly instead of white screen
    window.onerror = function(msg, url, line, col, error) {
      var root = document.getElementById('root');
      if (root && (!root.hasChildNodes() || root.innerHTML.trim() === '')) {
        root.innerHTML = '<div style="padding:2rem;font-family:Inter,system-ui,sans-serif;color:#fca5a5;background:#1e1e2e;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;">'
          + '<div style="width:48px;height:48px;border-radius:50%;background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.3);display:flex;align-items:center;justify-content:center;margin-bottom:1rem;font-size:24px;">⚠</div>'
          + '<h2 style="font-size:1.1rem;font-weight:600;margin-bottom:0.5rem;">Rendering Error</h2>'
          + '<p style="font-size:0.85rem;color:#a1a1aa;max-width:400px;line-height:1.5;">' + msg + '</p>'
          + '<p style="font-size:0.75rem;color:#71717a;margin-top:0.5rem;">Line ' + (line || '?') + '</p>'
          + '</div>';
      }
    };
  </script>
  <script type="text/babel" data-type="module" src="./src/App.jsx"></script>
  <script type="text/babel">
    // Mount the app with robust polling — waits for Babel to finish transpiling
    (function() {
      var root = ReactDOM.createRoot(document.getElementById('root'));
      var attempts = 0;
      var maxAttempts = 200; // 200 x 50ms = 10 seconds max wait
      function tryMount() {
        if (window.AppComponent) {
          try {
            root.render(React.createElement(window.AppComponent));
          } catch (e) {
            document.getElementById('root').innerHTML =
              '<div style="padding:2rem;font-family:Inter,system-ui,sans-serif;color:#fca5a5;background:#1e1e2e;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;">'
              + '<div style="width:48px;height:48px;border-radius:50%;background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.3);display:flex;align-items:center;justify-content:center;margin-bottom:1rem;font-size:24px;">⚠</div>'
              + '<h2 style="font-size:1.1rem;font-weight:600;margin-bottom:0.5rem;">Rendering Error</h2>'
              + '<p style="font-size:0.85rem;color:#a1a1aa;max-width:400px;line-height:1.5;">' + e.message + '</p>'
              + '</div>';
          }
        } else if (++attempts < maxAttempts) {
          setTimeout(tryMount, 50);
        } else {
          document.getElementById('root').innerHTML =
            '<div style="padding:2rem;font-family:Inter,system-ui,sans-serif;color:#fca5a5;background:#1e1e2e;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;">'
            + '<div style="width:48px;height:48px;border-radius:50%;background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.3);display:flex;align-items:center;justify-content:center;margin-bottom:1rem;font-size:24px;">⏱</div>'
            + '<h2 style="font-size:1.1rem;font-weight:600;margin-bottom:0.5rem;">Loading Timeout</h2>'
            + '<p style="font-size:0.85rem;color:#a1a1aa;max-width:400px;line-height:1.5;">The app took too long to compile. Please try refreshing.</p>'
            + '</div>';
        }
      }
      tryMount();
    })();
  </script>
</body>
</html>`,

  'src/App.jsx': `// Default App component — will be replaced by AI-generated code
function App() {
  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-900 via-purple-900 to-gray-900 flex items-center justify-center">
      <div className="text-center text-white">
        <h1 className="text-5xl font-bold mb-4 bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
          AI Website Builder
        </h1>
        <p className="text-gray-400 text-lg">
          Describe your website in the chat to get started
        </p>
      </div>
    </div>
  );
}

window.AppComponent = App;
`,

  'src/index.css': `/* Global styles — Tailwind CDN handles utilities */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Inter', sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
`,
};

/**
 * Get the default file for a given path if the LLM didn't generate it.
 */
export function getDefaultFile(filepath) {
  return templateFiles[filepath] || null;
}

/**
 * Get all template file paths.
 */
export function getTemplateFilePaths() {
  return Object.keys(templateFiles);
}
</file>

<file path="backend/context/TokenMonitor.js">
/**
 * TokenMonitor — estimates token counts and checks context limits.
 * Uses a word-based heuristic (words * 1.3) for fast estimation.
 */

import logger from '../utils/logger.js';
import { countTokens, countMessagesTokens } from '../utils/tokenizer.js';

class TokenMonitor {
  constructor() {
    this.maxTokens = parseInt(process.env.CONTEXT_MAX_TOKENS || '1500', 10);
    this.summaryThreshold = parseInt(process.env.CONTEXT_SUMMARY_THRESHOLD || '6', 10);
    this.triggerThresholdPercent = parseInt(process.env.CONTEXT_TRIGGER_THRESHOLD_PERCENT || '70', 10);
  }

  get triggerThresholdPercentValue() {
    return this.triggerThresholdPercent;
  }

  get thresholdTokens() {
    return Math.round(this.maxTokens * (this.triggerThresholdPercent / 100));
  }

  /**
   * Count tokens for a string using a real subword tokenizer (cl100k_base).
   * @param {string} text
   * @returns {number}
   */
  estimateTokens(text) {
    return countTokens(text);
  }

  /**
   * Count total tokens for a message array (includes per-message overhead).
   * @param {Array<{role: string, content: string}>} messages
   * @returns {number}
   */
  estimateMessagesTokens(messages) {
    return countMessagesTokens(messages);
  }

  /**
   * Check if messages exceed the token limit.
   * @param {Array<{role: string, content: string}>} messages
   * @param {number} [maxTokens] - Override default max
   * @returns {boolean}
   */
  isOverLimit(messages, maxTokens = null) {
    const limit = maxTokens || this.maxTokens;
    const estimated = this.estimateMessagesTokens(messages);
    return estimated > limit;
  }

  /**
   * Check if turn count has reached the summarization threshold.
   * @param {number} turnCount
   * @returns {boolean}
   */
  needsSummarization(turnCount) {
    return turnCount >= this.summaryThreshold;
  }

  /**
   * Get detailed token metrics for a session.
   * @param {Array} messages
   * @param {string} summary
   * @returns {Object}
   */
  getMetrics(messages, summary = '') {
    const messageTokens = this.estimateMessagesTokens(messages);
    const summaryTokens = this.estimateTokens(summary);
    return {
      messageTokens,
      summaryTokens,
      totalTokens: messageTokens + summaryTokens,
      maxTokens: this.maxTokens,
      utilization: ((messageTokens + summaryTokens) / this.maxTokens * 100).toFixed(1) + '%',
      isOverLimit: (messageTokens + summaryTokens) > this.maxTokens,
    };
  }
}

const tokenMonitor = new TokenMonitor();
export default tokenMonitor;
</file>

<file path="backend/llm/ClaudeProvider.js">
/**
 * Anthropic Claude LLM Provider — uses @anthropic-ai/sdk package.
 * Supports Claude 3.5 Sonnet, Claude 3 Opus, etc.
 */

import { BaseLLMProvider } from './BaseLLMProvider.js';
import logger from '../utils/logger.js';

export class ClaudeProvider extends BaseLLMProvider {
  constructor() {
    super();
    this._apiKey = process.env.CLAUDE_API_KEY || '';
    this._model = process.env.CLAUDE_MODEL || 'claude-sonnet-4-20250514';
    this._client = null;

    if (this._apiKey) {
      logger.info('Claude', `Initialized with model: ${this._model}`);
    }
  }

  get name() { return 'claude'; }
  get displayName() { return `Anthropic Claude (${this._model})`; }

  isConfigured() {
    return !!this._apiKey;
  }

  async _getClient() {
    if (!this._client) {
      try {
        const { default: Anthropic } = await import('@anthropic-ai/sdk');
        this._client = new Anthropic({ apiKey: this._apiKey });
      } catch {
        throw new Error('@anthropic-ai/sdk package not installed. Run: npm install @anthropic-ai/sdk');
      }
    }
    return this._client;
  }

  async generateResponse(prompt, context = []) {
    if (!this.isConfigured()) throw new Error('Claude not configured — set CLAUDE_API_KEY');

    const client = await this._getClient();

    // Claude uses a system prompt + messages format
    const systemPrompt = context.find(m => m.role === 'system')?.content || '';
    const messages = context
      .filter(m => m.role !== 'system')
      .map(m => ({ role: m.role, content: m.content }));
    messages.push({ role: 'user', content: prompt });

    const startTime = Date.now();
    const estimatedPromptTokens = Math.ceil(prompt.split(/\s+/).length * 1.3);

    try {
      const response = await client.messages.create({
        model: this._model,
        max_tokens: 16384,
        temperature: 0.7,
        system: systemPrompt || 'You are a React code generation AI. Always respond with valid JSON.',
        messages,
      });

      const content = response.content
        .filter(block => block.type === 'text')
        .map(block => block.text)
        .join('');

      const durationMs = Date.now() - startTime;
      const reportedPromptTokens = response.usage?.input_tokens || estimatedPromptTokens;
      const responseTokens = response.usage?.output_tokens || Math.ceil(content.split(/\s+/).length * 1.3);
      logger.logLLMCall('claude', reportedPromptTokens, responseTokens, durationMs);

      return {
        text: content.trim(),
        usage: {
          promptTokens: reportedPromptTokens,
          completionTokens: responseTokens,
          totalTokens: reportedPromptTokens + responseTokens,
          providerReported: !!response.usage?.input_tokens,
        },
      };
    } catch (error) {
      logger.error('Claude', `API error: ${error.message}`);
      throw error;
    }
  }

  async healthCheck() {
    if (!this.isConfigured()) return false;
    try {
      const client = await this._getClient();
      await client.messages.create({
        model: this._model,
        max_tokens: 10,
        messages: [{ role: 'user', content: 'hi' }],
      });
      return true;
    } catch {
      return false;
    }
  }
}
</file>

