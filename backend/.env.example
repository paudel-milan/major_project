# ─── Server ───
PORT=3001
SANDBOX_PORT=3002

# ─── LLM Provider (ollama | openai | gemini | claude) ───
LLM_PROVIDER=ollama

# ─── Ollama (PRIMARY) ───
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ─── OpenAI ───
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── Google Gemini ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Anthropic Claude ───
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ─── Context Management ───
CONTEXT_STRATEGY=recursive_summarization
CONTEXT_MAX_TOKENS=2000
CONTEXT_SUMMARY_THRESHOLD=6

# ─── Logging ───
LOG_LEVEL=info
